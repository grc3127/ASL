Options -Indexes
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_authz_core.c>
  <FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
